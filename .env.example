# ─── PocketBase ────────────────────────────────────────────
# URL del servidor PocketBase (backend)
PB_URL=http://localhost:8092

# Token de admin (para scripts de processing, webhooks, etc.)
# Obtenelo desde PocketBase > Settings > API Keys > New API Key
PB_ADMIN_TOKEN=

# ─── Frontend (Vite) ────────────────────────────────────────
# Estos los lee el navegador via import.meta.env
# Sobrescribí VITE_PB_URL para producción
VITE_PB_URL=http://localhost:8092
VITE_PB_URL_LOCAL=http://localhost:8092